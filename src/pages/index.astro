---
import Base from "@/layouts/Base.astro";
import { Features } from "@/components/Features.tsx";
---

<Base>
    <div class="flex flex-col max-h-screen snap-y snap-mandatory overflow-y-auto">
        <div class="p-6 grid min-h-screen snap-start place-items-center">
            <div class="space-y-6 lg:space-y-12 text-center">
                <h1
                    class="text-8xl font-bold px-2 py-1 text-mist-300"
                >
                    Hub
                </h1>
                <p class="text-lg lg:text-2xl text-mist-500">
                    The one place for your daily things
                </p>
            </div>
        </div>
        <div class="snap-start min-h-screen grid place-items-center">
            <Features />
        </div>
    </div>
</Base>
