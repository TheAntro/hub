---
import { Button } from "@/components/ui/button";
---

<header
    class="sticky top-0 z-40 flex items-center justify-between px-4 py-2 bg-background"
>
    <a href="/" aria-label="Go to home page"
        ><span class="text-xl font-bold text-foreground">Hub</span></a
    >
    <Button data-click="greet">Click me</Button>
</header>
<script>
    document
        .querySelector('[data-click="greet"]')
        ?.addEventListener("click", () => {
            console.log("Hello there!");
        });
</script>
